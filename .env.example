# Browser configuration for local development.
# These VITE_ values are included in the public browser bundle.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Optional fallback for projects that still use a legacy anon key.
# Prefer VITE_SUPABASE_PUBLISHABLE_KEY when available.
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Demo-only login values. They are not secret: VITE_ values are public in the
# browser bundle. Do not use this client-side login to protect production data.
VITE_ADMIN_USERNAME=
VITE_ADMIN_PASSWORD=
